{
  "name": "stadium-booking",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader native",
    "build": "vite build --configLoader native",
    "test": "node --test tests/unit.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/security.test.mjs",
    "test:security": "firebase emulators:exec --project demo-stadium-booking --only auth,firestore,storage,functions \"node --test --test-concurrency=1 tests/security.test.mjs\"",
    "emulators": "firebase emulators:start --project demo-stadium-booking --only auth,firestore,storage,functions",
    "preview": "vite preview --host 127.0.0.1 --configLoader native"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^15.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.0"
  }
}
